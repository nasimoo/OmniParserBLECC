from transformers import AutoProcessor, Gemma3ForConditionalGeneration
from PIL import Image
import requests
import torch
import argparse

# Add argument parsing for flexibility
parser = argparse.ArgumentParser(description='Run Gemma 3 model for image captioning')
parser.add_argument('--precision', choices=['fp16', 'fp32'], default='fp16', help='Model precision')
parser.add_argument('--fallback', action='store_true', help='Fall back to CPU if GPU fails')
args = parser.parse_args()

model_id = "mlx-community/gemma-3-4b-it-bf16"

# Determine device
device = "mps" if torch.backends.mps.is_available() and not args.fallback else "cpu"
print(f"Using device: {device}")

# Determine dtype based on precision argument
dtype = torch.float16 if args.precision == 'fp16' else torch.float32
print(f"Using precision: {args.precision}")

try:
    # Add a custom state dict loading function to fix Conv2d shape mismatch
    def fix_state_dict(state_dict):
        fixed_state_dict = {}
        for key, value in state_dict.items():
            # Check if this is a Conv2d weight tensor with channels last format
            if 'weight' in key and len(value.shape) == 4 and value.shape[-1] == 3:
                # Permute from [out_channels, h, w, in_channels] to [out_channels, in_channels, h, w]
                fixed_state_dict[key] = value.permute(0, 3, 1, 2).contiguous()
                print(f"Fixed shape for {key}: {value.shape} -> {fixed_state_dict[key].shape}")
            else:
                fixed_state_dict[key] = value
        return fixed_state_dict

    # First try with the fix_state_dict function
    model = Gemma3ForConditionalGeneration.from_pretrained(
        model_id, 
        device_map=device,
        torch_dtype=dtype,
        state_dict_callback=fix_state_dict
    ).eval()

except Exception as e:
    print(f"Error with custom state_dict loading: {e}")
    # If the custom method fails, try the direct loading with low_cpu_mem_usage
    try:
        print("Trying alternative loading method...")
        model = Gemma3ForConditionalGeneration.from_pretrained(
            model_id, 
            device_map=device,
            torch_dtype=dtype,
            low_cpu_mem_usage=True
        ).eval()
    except Exception as inner_e:
        print(f"Both loading methods failed. Error: {inner_e}")
        raise

processor = AutoProcessor.from_pretrained(model_id)

messages = [
    {
        "role": "system",
        "content": [{"type": "text", "text": "You are a helpful assistant."}]
    },
    {
        "role": "user",
        "content": [
            {"type": "image", "image": "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/bee.jpg"},
            {"type": "text", "text": "Describe this image in detail."}
        ]
    }
]

inputs = processor.apply_chat_template(
    messages, add_generation_prompt=True, tokenize=True,
    return_dict=True, return_tensors="pt"
).to(model.device, dtype=model.dtype)

input_len = inputs["input_ids"].shape[-1]

print("Starting generation...")
with torch.inference_mode():
    generation = model.generate(**inputs, max_new_tokens=100, do_sample=False)
    generation = generation[0][input_len:]

decoded = processor.decode(generation, skip_special_tokens=True)
print(f"Generated result:\n{decoded}")

# **Overall Impression:** The image is a close-up shot of a vibrant garden scene, 
# focusing on a cluster of pink cosmos flowers and a busy bumblebee. 
# It has a slightly soft, natural feel, likely captured in daylight.
